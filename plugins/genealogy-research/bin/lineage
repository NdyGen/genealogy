#!/usr/bin/env bash
# The lineage CLI from this plugin, and `lineage round <command>` for the research-round scripts.
# The venv lives in the plugin data dir, because the plugin root is replaced on every update; uv syncs it on
# first use and whenever uv.lock changes.
set -euo pipefail
# Follows the symlinks (a link in ~/.local/bin, the plugin cache) without readlink -f, which older macOS lacks.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in /*) self=$link;; *) self="$(dirname "$self")/$link";; esac
done
ROOT=$(cd "$(dirname "$self")/.." && pwd)
# The venv's own `lineage` comes first on PATH under `uv run` and knows no `round`: subprocesses (the guard,
# the round scripts) must reach this wrapper.
export LINEAGE_BIN="$ROOT/bin/lineage"
case ":$PATH:" in *":$ROOT/bin:"*) ;; *) PATH="$ROOT/bin:$PATH";; esac
if [ "${1:-}" = round ]; then
  command=${2:?usage: lineage round <start|helper|finish|merge|undo|watch|start-guard|start-coordinator> ...}
  script="$ROOT/scripts/round/$command.sh"
  [ -f "$script" ] || { echo "unknown round command: $command" >&2; exit 2; }
  shift 2
  exec bash "$script" "$@"
fi
command -v uv >/dev/null || { echo "lineage needs uv: https://docs.astral.sh/uv/getting-started/installation/" >&2; exit 127; }
if [ -z "${LINEAGE_VENV:-}" ]; then
  data="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/data"
  LINEAGE_VENV="$data/genealogy-research-genealogy/venv"
  for d in "$data"/genealogy-research-*/; do [ -d "$d/venv" ] && { LINEAGE_VENV="${d%/}/venv"; break; }; done
fi
export UV_PROJECT_ENVIRONMENT="$LINEAGE_VENV"
exec uv run --quiet --frozen --no-dev --project "$ROOT/cli" lineage "$@"
